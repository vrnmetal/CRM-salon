# Скопируй в .env и поправь под себя.
# ВАЖНО: НЕ ставь пробелы после "=" — Django прочитает их как часть значения.

SECRET_KEY=dev-insecure-change-me
DEBUG=1
# USE_HTTPS — отдельный флаг, НЕ завязан на DEBUG. Локально по http держим 0.
USE_HTTPS=0

ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
BASE_DOMAIN=localhost

# База. Для запуска без Docker можно DB_ENGINE=sqlite.
DB_ENGINE=postgres
DB_NAME=salon
DB_USER=salon
DB_PASSWORD=salon
DB_HOST=127.0.0.1
# 5433 — чтобы не пересекаться с Postgres ремонтной CRM (у неё 5432).
DB_PORT=5433
